{
  "apiVersion": 1,
  "id": "eidos.dashboard",
  "name": "%plugin.name%",
  "version": "0.2.0",
  "requires": {
    "pluginApi": "3.7.0"
  },
  "workspace": {
    "files": {
      "read": true
    }
  },
  "views": [
    {
      "id": "main",
      "title": "%views.main.title%",
      "kind": "file",
      "entry": "./src/main.ts",
      "access": "write",
      "capabilities": [
        "document"
      ]
    }
  ],
  "placements": [
    {
      "location": "file/open",
      "view": "main",
      "extensions": [
        ".dashboard"
      ]
    }
  ],
  "fileTemplates": [
    {
      "id": "blank",
      "title": "%fileTemplates.blank.title%",
      "extension": ".dashboard",
      "view": "main",
      "content": "{\n  \"kind\": \"eidos-dashboard\",\n  \"version\": 1,\n  \"title\": \"Dashboard\",\n  \"columns\": 12,\n  \"panels\": []\n}\n"
    }
  ],
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
